@@ -1502,0 +1522,46 @@ static void Task_StartMenu_WaitEvolution(TaskManager *taskManager) {
+
+static BOOL StartMenu_WonderTradeAvailable(FieldSystem *fieldSystem, StartMenuTaskData *startMenu) {
+    // Safari, Bug-Catching Contest, Pal Park, Union Room and similar menus forbid saving.
+    return !(startMenu->inhibitIconFlags & (1 << START_MENU_ACTION_DISABLE_SAVE))
+        && !(startMenu->inhibitIconFlags & (1 << START_MENU_ACTION_DISABLE_POKEMON))
+        && Party_GetCount(SaveArray_Party_Get(fieldSystem->saveData)) > 0;
+}
+
+static BOOL StartMenu_SelectWonderTrade(TaskManager *taskManager, FieldSystem *fieldSystem, StartMenuTaskData *startMenu, BOOL touch) {
+    fieldSystem->lastTouchMenuInput = 0;
+    if (!StartMenu_WonderTradeAvailable(fieldSystem, startMenu)) {
+        return TRUE;
+    }
+    PlaySE(SEQ_SE_DP_SELECT);
+    MenuInputStateMgr_SetState(&fieldSystem->menuInputState, touch ? MENU_INPUT_STATE_TOUCH : MENU_INPUT_STATE_BUTTONS);
+    sub_0203DF64(fieldSystem, touch);
+    ov01_021F6B50(fieldSystem);
+    return Task_StartMenu_HandleSelection_WonderTrade(taskManager);
+}
+
+static BOOL Task_StartMenu_HandleSelection_WonderTrade(TaskManager *taskManager) {
+    StartMenuTaskData *startMenu = (StartMenuTaskData *)TaskManager_GetEnvironment(taskManager);
+
+    FieldMap_FadeScreen(FADE_TYPE_BRIGHTNESS_OUT);
+    startMenu->exitTaskFunc = Task_StartMenu_WonderTrade;
+    startMenu->state = START_MENU_STATE_WAIT_FADE;
+    return TRUE;
+}
+
+static BOOL Task_StartMenu_WonderTrade(TaskManager *taskManager) {
+    FieldSystem *fieldSystem = TaskManager_GetFieldSystem(taskManager);
+    StartMenuTaskData *startMenu = (StartMenuTaskData *)TaskManager_GetEnvironment(taskManager);
+
+    FieldSystem_LaunchApplication(fieldSystem, &gWonderTradeAppTemplate, fieldSystem);
+    startMenu->exitTaskFunc = Task_StartMenu_HandleReturn_WonderTrade;
+    return FALSE;
+}
+
+static BOOL Task_StartMenu_HandleReturn_WonderTrade(TaskManager *taskManager) {
+    FieldSystem *fieldSystem = TaskManager_GetFieldSystem(taskManager);
+    StartMenuTaskData *startMenu = (StartMenuTaskData *)TaskManager_GetEnvironment(taskManager);
+
+    FieldSystem_LoadFieldOverlay(fieldSystem);
+    startMenu->state = START_MENU_STATE_RETURN;
+    return FALSE;
+}
