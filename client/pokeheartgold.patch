@@ -1431,0 +1439,23 @@ Overlay OVY_128
+
+# Wonder Trade runs with the field unloaded and the Wi-Fi libraries (OVY_0)
+# loaded, like the other Wi-Fi applications after OVY_0. It must end before
+# OVY_12 does, or the main arena would start later and HGSS's boot heaps would
+# no longer fit. Its templates, the save gates, the entropy hook and SHA-256
+# stay in the static binary.
+Overlay wonder_trade
+{
+    After OVY_0
+    Object src/wonder_trade/hgss/application.c
+    Object src/wonder_trade/network.c
+    Object src/wonder_trade/tls.c
+    Object src/wonder_trade/http.c
+    Object src/wonder_trade/wire.c
+    Object src/wonder_trade/seed.c
+    Object src/wonder_trade/journal.c
+    Object src/wonder_trade/engine.c
+    Object src/wonder_trade/pokemon_codec.c
+    Object src/wonder_trade/hgss/game_save.c
+    Object src/wonder_trade/flash.c
+    Object src/wonder_trade/boot.c
+    Library libwonder_trade_tls.a
+}
