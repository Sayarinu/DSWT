+        return;
+    }
@@ -167,0 +181,3 @@ int sub_02022854(struct SaveData *save) {
+    if (sWonderTradeBlocked) {
+        return 3;
+    }
@@ -175,0 +192,3 @@ void sub_0202287C(struct SaveData *save) {
+    if (sWonderTradeBlocked) {
+        return;
+    }
@@ -640,0 +660,3 @@ int WriteSaveFileToFlash(struct SaveData *save, int idx, u8 *data) {
+    if (!WtRecovery_CanWrite()) {
+        return 3;
+    }
@@ -734,0 +757,3 @@ int FlashWriteChunk(u32 offset, u8 *data, u32 size) {
+    if (!WtRecovery_CanWrite()) {
+        return FALSE;
+    }
@@ -762,0 +788,5 @@ int FlashWriteChunkInternal(u32 dest, void *src, u32 size) {
+    // Every retail write ends here; a refused one reports a failed write.
