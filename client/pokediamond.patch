+static BOOL sWonderTradeRefused;
@@ -67,0 +71,3 @@ BOOL sub_0202263C(struct SaveData *save) {
+    if (!WtRecovery_Started() || !WtRecovery_CanClear()) {
+        return FALSE;
+    }
@@ -98,0 +105,3 @@ int SaveGame(struct SaveData *save) {
