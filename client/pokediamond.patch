diff --git a/arm9/Makefile b/arm9/Makefile
--- a/arm9/Makefile
+++ b/arm9/Makefile
@@ -68 +68 @@ LD_TEMPLATE := ARM9-TS.lcf.template
-SRC_DIRS := src lib lib/libnns/src lib/NitroSDK/src lib/MSL_C/src $(sort $(wildcard overlays/*/src))
+SRC_DIRS := src src/wonder_trade src/wonder_trade/dp lib lib/libnns/src lib/NitroSDK/src lib/MSL_C/src $(sort $(wildcard overlays/*/src))
@@ -131 +131 @@ MWLDFLAGS = -w off -sym on -proc v5te -interworking -map closure,unused -symtab
-LIBS := -Llib -lsyscall
+LIBS := -Llib -lsyscall -lwonder_trade_tls
@@ -133 +133 @@ ARFLAGS = rcS
-STATIC_LIBS := $(addprefix $(BUILD_DIR)/lib/,libsyscall.a)
+STATIC_LIBS := $(addprefix $(BUILD_DIR)/lib/,libsyscall.a libwonder_trade_tls.a)
@@ -220,0 +221,44 @@ $(BUILD_DIR)/lib/MSL_C/%.o: MWCFLAGS += -ipa file
+# Wonder Trade: the shared core, the Diamond/Pearl adapter and Mbed TLS build
+# against CodeWarrior's MSL C headers instead of the partial lib/MSL_C copy, and
+# against declaration-only SDK shims from include/wonder_trade/dp/sdk.
+WT_TLS_DIR ?= /tls
+WT_MSL_DIR ?= /opt/pokediamond/msl
+WT_PROFILE_HEADER ?= ../.git/dswt-connection.h
+WT_TLS_SRC_DIRS := library tf-psa-crypto/core tf-psa-crypto/extras tf-psa-crypto/platform \
+	tf-psa-crypto/utilities tf-psa-crypto/drivers/builtin/src
+WT_TLS_INCLUDE_DIRS := include library tf-psa-crypto/include tf-psa-crypto/core tf-psa-crypto/dispatch \
+	tf-psa-crypto/extras tf-psa-crypto/platform tf-psa-crypto/utilities \
+	tf-psa-crypto/drivers/builtin/include tf-psa-crypto/drivers/builtin/src tf-psa-crypto/drivers/p256-m \
+	tf-psa-crypto/drivers/pqcp/include tf-psa-crypto/drivers/everest/include
+WT_TLS_C_FILES := $(foreach dir,$(WT_TLS_SRC_DIRS),$(sort $(wildcard $(WT_TLS_DIR)/$(dir)/*.c)))
+WT_TLS_OBJS := $(WT_TLS_C_FILES:$(WT_TLS_DIR)/%.c=$(BUILD_DIR)/wt_tls/%.o)
+WT_C_OBJS := $(filter $(BUILD_DIR)/src/wonder_trade/%,$(C_OBJS))
+WT_MSL_INCLUDES := $(WT_MSL_DIR)/MSL_C/MSL_Common/Include $(WT_MSL_DIR)/MSL_C/MSL_ARM/Include
+WT_TLS_MWCFLAGS = -O4,p -sym on -gccext,on -proc arm946e -thumb -msgstyle gcc -gccinc -fp soft -lang c99 \
+	-Cpp_exceptions off -inline on,noauto -i ../include -i ../include/wonder_trade/dp/sdk -i ../files -i $(BUILD_DIR) \
+	$(foreach dir,$(WT_TLS_INCLUDE_DIRS),-i $(WT_TLS_DIR)/$(dir)) -ir ../include-mw \
+	$(foreach dir,$(WT_MSL_INCLUDES) lib/libnns/include lib/NitroSDK/include,-ir $(dir)) \
+	-interworking -DFS_IMPLEMENT -enum int -D$(GAME_VERSION) -D$(GAME_LANGUAGE) \
+	'-DMBEDTLS_CONFIG_FILE="wonder_trade/tls_config.h"' '-DTF_PSA_CRYPTO_CONFIG_FILE="wonder_trade/crypto_config.h"' \
+	-W all -W noimpl_signedunsigned -W noimplicitconv -W nounusedarg -W nomissingreturn
+
+WT_MWCFLAGS = $(WT_TLS_MWCFLAGS) -prefix wonder_trade/dp/sdk_prefix.h
+
+$(WT_C_OBJS): MWCFLAGS = $(WT_MWCFLAGS)
+$(WT_TLS_OBJS): MWCFLAGS = $(WT_TLS_MWCFLAGS)
+# The game itself must stay on 2.0/sp1 to match retail. Wonder Trade and Mbed TLS
+# use 2.0/sp2p2, the compiler Platinum and HeartGold/SoulSilver build them with.
+$(WT_C_OBJS) $(WT_TLS_OBJS): CC = $(WINE) $(TOOLS_DIR)/mwccarm/2.0/sp2p2/mwccarm.exe
+$(WT_C_OBJS) $(WT_TLS_OBJS): export MWCIncludes := $(WT_MSL_INCLUDES)
+$(WT_C_OBJS): $(BUILD_DIR)/wonder_trade_config.h
+
+$(BUILD_DIR)/wonder_trade_config.h: $(WT_PROFILE_HEADER)
+	cp $< $@
+
+$(WT_TLS_OBJS): $(BUILD_DIR)/wt_tls/%.o: $(WT_TLS_DIR)/%.c
+	@mkdir -p $(dir $@)
+	$(CC) -c $(MWCFLAGS) -o $@ $<
+
+$(BUILD_DIR)/lib/libwonder_trade_tls.a: $(WT_TLS_OBJS)
+	$(AR) $(ARFLAGS) -o $@ $^
+
