<?xml version="1.0"?>
<body language="English">
	<row id="WonderTrade_Text_Title" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WONDER TRADE</language>
		<language name="French">ECHANGE MIRACLE</language>
		<language name="German">WUNDERTAUSCH</language>
		<language name="Italian">SCAMBIO PRODIGIOSO</language>
		<language name="Spanish">INTERCAMBIO PRODIGIOSO</language>
		<language name="Japanese">ミラクルこうかん</language>
		<language name="Korean">미라클교환</language>
	</row>
	<row id="WonderTrade_Text_Trade" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wonder Trade</language>
		<language name="French">Echange Miracle</language>
		<language name="German">Wundertausch</language>
		<language name="Italian">Scambio Prodigioso</language>
		<language name="Spanish">Intercambio Prodigioso</language>
		<language name="Japanese">ミラクルこうかん</language>
		<language name="Korean">미라클교환</language>
	</row>
	<row id="WonderTrade_Text_Info" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Info</language>
		<language name="French">Infos</language>
		<language name="German">Infos</language>
		<language name="Italian">Info</language>
		<language name="Spanish">Info</language>
		<language name="Japanese">せつめい</language>
		<language name="Korean">설명</language>
	</row>
	<row id="WonderTrade_Text_Exit" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Exit</language>
		<language name="French">Quitter</language>
		<language name="German">Zurück</language>
		<language name="Italian">Esci</language>
		<language name="Spanish">Salir</language>
		<language name="Japanese">やめる</language>
		<language name="Korean">그만둔다</language>
	</row>
