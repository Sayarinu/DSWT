<?xml version="1.0"?>
<body language="English">
	<row id="WonderTrade_Text_Title" index="0">
		<attribute name="window_context_name">used</attribute>
		<language name="English">WONDER TRADE</language>
		<language name="French">ECHANGE MIRACLE</language>
		<language name="German">WUNDERTAUSCH</language>
		<language name="Italian">SCAMBIO PRODIGIOSO</language>
		<language name="Spanish">INTERCAMBIO PRODIGIOSO</language>
		<language name="Japanese">ミラクルこうかん</language>
		<language name="Korean">미라클교환</language>
	</row>
	<row id="WonderTrade_Text_Trade" index="1">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wonder Trade</language>
		<language name="French">Echange Miracle</language>
		<language name="German">Wundertausch</language>
		<language name="Italian">Scambio Prodigioso</language>
		<language name="Spanish">Intercambio Prodigioso</language>
		<language name="Japanese">ミラクルこうかん</language>
		<language name="Korean">미라클교환</language>
	</row>
	<row id="WonderTrade_Text_Info" index="2">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Info</language>
		<language name="French">Infos</language>
		<language name="German">Infos</language>
		<language name="Italian">Info</language>
		<language name="Spanish">Info</language>
		<language name="Japanese">せつめい</language>
		<language name="Korean">설명</language>
	</row>
	<row id="WonderTrade_Text_Exit" index="3">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Exit</language>
		<language name="French">Quitter</language>
		<language name="German">Zurück</language>
		<language name="Italian">Esci</language>
		<language name="Spanish">Salir</language>
		<language name="Japanese">やめる</language>
		<language name="Korean">그만둔다</language>
	</row>
	<row id="WonderTrade_Text_Retry" index="4">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Retry</language>
		<language name="French">Réessayer</language>
		<language name="German">Nochmal</language>
		<language name="Italian">Riprova</language>
		<language name="Spanish">Reintentar</language>
		<language name="Japanese">もういちど</language>
		<language name="Korean">다시 시도</language>
	</row>
	<row id="WonderTrade_Text_Back" index="5">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Back</language>
		<language name="French">Retour</language>
		<language name="German">Zurück</language>
		<language name="Italian">Indietro</language>
		<language name="Spanish">Atrás</language>
		<language name="Japanese">もどる</language>
		<language name="Korean">돌아간다</language>
	</row>
	<row id="WonderTrade_Text_Cancel" index="6">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cancel</language>
		<language name="French">Annuler</language>
		<language name="German">Zurück</language>
		<language name="Italian">Esci</language>
		<language name="Spanish">Cancelar</language>
		<language name="Japanese">やめる</language>
		<language name="Korean">취소</language>
	</row>
	<row id="WonderTrade_Text_Connecting" index="7">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Connecting to Wi-Fi...\nPlease wait.</language>
		<language name="French">Connexion en cours... Veuillez\npatienter.</language>
		<language name="German">Verbindung... Bitte warte einen\nMoment.</language>
		<language name="Italian">Connessione... Attendi un momento.</language>
		<language name="Spanish">Conectando... Espera un momento.</language>
		<language name="Japanese">せつぞく　しています\nしばらく　おまちください</language>
		<language name="Korean">접속하고 있습니다\n잠시만 기다려주십시오</language>
	</row>
	<row id="WonderTrade_Text_Disconnecting" index="8">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Disconnecting...\nPlease wait.</language>
		<language name="French">Déconnexion... Veuillez patienter.</language>
		<language name="German">Verbindung wird beendet... Bitte\nwarte.</language>
		<language name="Italian">Disconnessione... Attendi un\nmomento.</language>
		<language name="Spanish">Desconectando... Espera un momento.</language>
		<language name="Japanese">つうしんを　しゅうりょう　します\nしばらく　おまちください</language>
		<language name="Korean">통신을 종료합니다\n잠시만 기다려주십시오</language>
	</row>
	<row id="WonderTrade_Text_Choose" index="9">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Choose a party Pokémon\nto offer for Wonder Trade.</language>
		<language name="French">Choisissez un Pokémon de votre\néquipe.</language>
		<language name="German">Wähle ein Pokémon aus deinem Team.</language>
		<language name="Italian">Scegli un Pokémon della squadra.</language>
		<language name="Spanish">Elige un Pokémon de tu equipo.</language>
		<language name="Japanese">だす　ポケモンを\nえらんでください</language>
		<language name="Korean">내놓을 포켓몬을\n선택해 주십시오</language>
	</row>
	<row id="WonderTrade_Text_Pinging" index="10">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Saving and contacting the server.\nDo not turn off the power.</language>
		<language name="French">Sauvegarde et connexion... Ne pas\néteindre.</language>
		<language name="German">Speichern und verbinden... System\nnicht ausschalten.</language>
		<language name="Italian">Salvataggio e connessione. Non\nspegnere.</language>
		<language name="Spanish">Guardando y conectando... No\napagues la consola.</language>
		<language name="Japanese">レポートを　かいています\nでんげんを　きらないでください</language>
		<language name="Korean">리포트를 작성하고 있습니다\n전원을 끄지 마십시오</language>
	</row>
	<row id="WonderTrade_Text_ConnectionError" index="11">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Couldn’t connect to the internet.\nCheck your Nintendo WFC settings\nand that your access point is\nin range, then try again.</language>
		<language name="French">Impossible de se connecter à Internet.\nVérifiez vos paramètres de la CWF\nNintendo et la portée de votre point\nd’accès, puis réessayez.</language>
		<language name="German">Keine Verbindung zum Internet.\nÜberprüfe die Einstellungen der Nintendo\nWFC und ob dein Zugangspunkt in\nReichweite ist, und versuche es dann\nnoch einmal.</language>
		<language name="Italian">Impossibile connettersi a Internet.\nControlla le impostazioni della Nintendo\nWFC e che il punto di accesso sia nel\nraggio d’azione, poi riprova.</language>
		<language name="Spanish">No se ha podido conectar a Internet.\nComprueba la configuración de la CWF de\nNintendo y que el punto de acceso esté\ncerca, y vuelve a intentarlo.</language>
		<language name="Japanese">インターネットに\nせつぞく　できませんでした\nニンテンドーWi‐Fiコネクションの\nせっていを　かくにんして\nもういちど　ためしてください</language>
		<language name="Korean">인터넷에 접속할 수 없었습니다\n닌텐도 Wi-Fi 커넥션 설정을\n확인하고 다시 시도해 주십시오</language>
	</row>
	<row id="WonderTrade_Text_PingError" index="12">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Something went wrong while\ncontacting Wonder Trade.\nPlease try again. If it keeps\nhappening, note the code below.</language>
		<language name="French">Erreur de communication avec l’Echange\nMiracle. Veuillez réessayer. Si l’erreur\nse répète, notez le code ci-dessous.</language>
		<language name="German">Verbindungsfehler beim Wundertausch.\nBitte versuche es noch einmal. Tritt der\nFehler erneut auf, notiere den Code\nunten.</language>
		<language name="Italian">Errore di comunicazione con lo Scambio\nProdigioso. Riprova. Se l’errore si\nripete, annota il codice qui sotto.</language>
		<language name="Spanish">Error de conexión con el Intercambio\nProdigioso. Vuelve a intentarlo. Si se\nrepite, anota el código de abajo.</language>
		<language name="Japanese">つうしんエラーが　はっせい　しました\nもういちど　ためしてください\nなんども　おきるときは\nしたの　コードを　ひかえてください</language>
		<language name="Korean">통신 에러가 발생했습니다\n다시 시도해 주십시오\n계속 발생하면\n아래 코드를 적어 두십시오</language>
	</row>
	<row id="WonderTrade_Text_Ineligible" index="13">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cannot offer this Pokémon.\nKeep another usable Pokémon.\nNo Eggs, mail or capsules.</language>
		<language name="French">Ce Pokémon ne peut pas faire l’objet\nd’un échange. Gardez un autre Pokémon\napte au combat. Pas d’Oeufs, de Lettres\nni de Capsules Ball.</language>
		<language name="German">Dieses Pokémon kann nicht zum Tausch\nangeboten werden. Behalte ein anderes\nkampffähiges Pokémon. Keine Eier, Briefe\noder Ballkapseln.</language>
		<language name="Italian">Quel Pokémon non può essere scambiato.\nTieni un altro Pokémon in grado di\nlottare. Niente Uova, Messaggi o\nCapsule.</language>
		<language name="Spanish">No se puede intercambiar ese Pokémon.\nConserva otro Pokémon que pueda\ncombatir. Sin huevos, cartas ni\ncápsulas.</language>
		<language name="Japanese">その　ポケモンは　だせません！\nたたかえる　ポケモンを\nほかに　のこしてください\nタマゴ　メール　カプセルは　だせません</language>
		<language name="Korean">그 포켓몬은 내놓을 수 없습니다!\n싸울 수 있는 포켓몬을\n남겨 주십시오\n알, 메일, 캡슐은 안 됩니다</language>
	</row>
	<row id="WonderTrade_Text_Duplicate" index="14">
		<attribute name="window_context_name">used</attribute>
		<language name="English">An identical or damaged Pokémon\nin your party or PC blocks this.</language>
		<language name="French">Un Pokémon identique ou endommagé\nbloque l’échange.</language>
		<language name="German">Ein gleiches oder beschädigtes\nPokémon verhindert dies.</language>
		<language name="Italian">Un Pokémon identico o danneggiato lo\nimpedisce.</language>
		<language name="Spanish">Un Pokémon idéntico o dañado lo\nimpide.</language>
		<language name="Japanese">おなじか　こわれた　ポケモンが\nいるので　だせません</language>
		<language name="Korean">똑같거나 손상된 포켓몬이\n있어 내놓을 수 없습니다</language>
	</row>
	<row id="WonderTrade_Text_Explanation" index="15">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trade a party Pokémon with a\nrandom player. It waits safely\non the server until matched.\nCheck back to collect it, or\ncancel before a match.\nOne offer per save.</language>
		<language name="French">Echangez un Pokémon de votre équipe\navec un Dresseur au hasard. Il attend\nen sécurité sur le serveur. Revenez\npour récupérer le résultat, ou annulez\navant l’échange. Une offre par\nsauvegarde.</language>
		<language name="German">Tausche ein Pokémon aus deinem Team mit\neinem zufälligen Trainer. Es wartet\nsicher auf dem Server. Komm zurück, um\ndas Ergebnis abzuholen, oder brich\nvorher ab. Ein Angebot pro Spielstand.</language>
		<language name="Italian">Scambia un Pokémon della squadra con un\nAllenatore a caso. Attende al sicuro sul\nserver. Torna a ritirare il risultato o\nannulla prima dello scambio. Un’offerta\nper salvataggio.</language>
		<language name="Spanish">Intercambia un Pokémon de tu equipo con\nun Entrenador al azar. Espera seguro en\nel servidor. Vuelve para recoger el\nresultado o cancela antes del\nintercambio. Una oferta por partida.</language>
		<language name="Japanese">てもちの　ポケモンを\nだれかと　こうかん　します\nあいてが　みつかるまで\nサーバーで　あずかります\nあとで　うけとるか\nそのまえに　とりけしてください\nひとつの　レポートに　ひとつまで</language>
		<language name="Korean">지닌 포켓몬을\n누군가와 교환합니다\n상대가 정해질 때까지\n서버에서 맡아 둡니다\n나중에 받거나\n그 전에 취소해 주십시오\n리포트 하나에 하나까지</language>
	</row>
	<row id="WonderTrade_Text_Diagnostics" index="16">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Connection details</language>
		<language name="French">Détails de connexion</language>
		<language name="German">Verbindungsdetails</language>
		<language name="Italian">Dettagli connessione</language>
		<language name="Spanish">Detalles de conexión</language>
		<language name="Japanese">せつぞくの　じょうほう</language>
		<language name="Korean">접속 정보</language>
	</row>
	<row id="WonderTrade_Text_ErrorCode" index="17">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Support code</language>
		<language name="French">Code d’assistance</language>
		<language name="German">Support-Code</language>
		<language name="Italian">Codice assistenza</language>
		<language name="Spanish">Código de asistencia</language>
		<language name="Japanese">サポートコード</language>
		<language name="Korean">지원 코드</language>
	</row>
	<row id="WonderTrade_Text_ConnectMs" index="18">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Connect ms</language>
		<language name="French">Connexion ms</language>
		<language name="German">Verbindung ms</language>
		<language name="Italian">Connessione ms</language>
		<language name="Spanish">Conexión ms</language>
		<language name="Japanese">せつぞく　ms</language>
		<language name="Korean">접속 ms</language>
	</row>
	<row id="WonderTrade_Text_TlsBytes" index="19">
		<attribute name="window_context_name">used</attribute>
		<language name="English">TLS bytes</language>
		<language name="French">Octets TLS</language>
		<language name="German">TLS-Bytes</language>
		<language name="Italian">Byte TLS</language>
		<language name="Spanish">Bytes TLS</language>
		<language name="Japanese">TLS　バイト</language>
		<language name="Korean">TLS 바이트</language>
	</row>
	<row id="WonderTrade_Text_StackBytes" index="20">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Stack bytes</language>
		<language name="French">Octets pile</language>
		<language name="German">Stack-Bytes</language>
		<language name="Italian">Byte stack</language>
		<language name="Spanish">Bytes pila</language>
		<language name="Japanese">スタック　バイト</language>
		<language name="Korean">스택 바이트</language>
	</row>
	<row id="WonderTrade_Text_FrameMs" index="21">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Frame gap ms</language>
		<language name="French">Ecart image ms</language>
		<language name="German">Bildlücke ms</language>
		<language name="Italian">Pausa frame ms</language>
		<language name="Spanish">Pausa fotograma ms</language>
		<language name="Japanese">フレーム　ms</language>
		<language name="Korean">프레임 ms</language>
	</row>
	<row id="WonderTrade_Text_CheckingSave" index="22">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Checking saved game...\nPlease wait.</language>
		<language name="French">Vérification de la sauvegarde...\nVeuillez patienter.</language>
		<language name="German">Spielstand wird geprüft... Bitte\nwarte.</language>
		<language name="Italian">Verifica del salvataggio... Attendi.</language>
		<language name="Spanish">Comprobando la partida... Espera un\nmomento.</language>
		<language name="Japanese">レポートを　かくにん　しています\nしばらく　おまちください</language>
		<language name="Korean">리포트를 확인하고 있습니다\n잠시만 기다려주십시오</language>
	</row>
	<row id="WonderTrade_Text_RecoveryRequired" index="23">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trade recovery required.\nConnect to try again.\n\nKeep this save and its\nrecovery files.</language>
		<language name="French">L’échange doit être récupéré.\nConnectez-vous pour réessayer.\n\nConservez cette sauvegarde et ses\nfichiers de récupération.</language>
		<language name="German">Der Tausch muss wiederhergestellt\nwerden. Verbinde dich, um es noch einmal\nzu versuchen.\n\nBehalte diesen Spielstand und seine\nWiederherstellungsdateien.</language>
		<language name="Italian">Lo scambio deve essere ripristinato.\nConnettiti per riprovare.\n\nConserva questo salvataggio e i suoi file\ndi ripristino.</language>
		<language name="Spanish">Hay que recuperar el intercambio.\nConéctate para volver a intentarlo.\n\nConserva esta partida y sus archivos de\nrecuperación.</language>
		<language name="Japanese">こうかんの　ふっきゅうが\nひつようです\nせつぞくして　もういちど\nためしてください\n\nこの　レポートと\nふっきゅうファイルを\nのこしてください</language>
		<language name="Korean">교환 복구가 필요합니다\n접속해서 다시 시도해 주십시오\n\n이 리포트와\n복구 파일을 보관해 주십시오</language>
	</row>
	<row id="WonderTrade_Text_Confirm" index="24">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Offer the selected Pokémon?\nIt will leave your party.</language>
		<language name="French">Proposer ce Pokémon? Il quittera\nvotre équipe.</language>
		<language name="German">Dieses Pokémon anbieten? Es verlässt\ndein Team.</language>
		<language name="Italian">Offrire questo Pokémon? Lascerà la\nsquadra.</language>
		<language name="Spanish">¿Ofrecer este Pokémon? Saldrá de tu\nequipo.</language>
		<language name="Japanese">この　ポケモンを　だしますか？\nてもちから　いなくなります</language>
		<language name="Korean">이 포켓몬을 내놓겠습니까?\n지닌 포켓몬에서 빠집니다</language>
	</row>
	<row id="WonderTrade_Text_Queued" index="25">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your trade is pending. Choose\nCollect result to check it.</language>
		<language name="French">Echange en attente. Choisissez\nRécupérer.</language>
		<language name="German">Tausch offen. Wähle Ergebnis\nabholen.</language>
		<language name="Italian">Scambio in attesa. Scegli Ritira\nrisultato.</language>
		<language name="Spanish">Intercambio pendiente. Elige Recoger\nresultado.</language>
		<language name="Japanese">こうかんを　まっています\nけっかを　うけとって　ください</language>
		<language name="Korean">교환을 기다리고 있습니다\n결과 받기를 선택해 주십시오</language>
	</row>
	<row id="WonderTrade_Text_Collect" index="26">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Collect result</language>
		<language name="French">Récupérer</language>
		<language name="German">Ergebnis abholen</language>
		<language name="Italian">Ritira risultato</language>
		<language name="Spanish">Recoger resultado</language>
		<language name="Japanese">けっかを　うけとる</language>
		<language name="Korean">결과 받기</language>
	</row>
	<row id="WonderTrade_Text_CancelOffer" index="27">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cancel offer</language>
		<language name="French">Annuler l’offre</language>
		<language name="German">Angebot zurückziehen</language>
		<language name="Italian">Annulla offerta</language>
		<language name="Spanish">Cancelar oferta</language>
		<language name="Japanese">とりけす</language>
		<language name="Korean">취소한다</language>
	</row>
	<row id="WonderTrade_Text_ConfirmCollect" index="28">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Collect your trade result? Trade\nevolution keeps current moves.</language>
		<language name="French">Récupérer? L’évolution conserve les\ncapacités.</language>
		<language name="German">Ergebnis abholen? Attacken bleiben\nbei Entwicklung.</language>
		<language name="Italian">Ritirare il risultato? Le mosse\nrestano uguali.</language>
		<language name="Spanish">¿Recoger el resultado? Conserva sus\nmovimientos.</language>
		<language name="Japanese">けっかを　うけとりますか？\nしんかしても　わざは　そのまま</language>
		<language name="Korean">결과를 받겠습니까?\n진화해도 기술은 그대로입니다</language>
	</row>
	<row id="WonderTrade_Text_ConfirmCancel" index="29">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Cancel an unmatched offer? If\nmatched, collect it instead.</language>
		<language name="French">Annuler l’offre? Si échangée,\nrécupérez-la.</language>
		<language name="German">Angebot zurückziehen? Wenn\ngetauscht, abholen.</language>
		<language name="Italian">Annullare l’offerta? Se scambiata,\nritirala.</language>
		<language name="Spanish">¿Cancelar la oferta? Si ya hubo\nintercambio, recógelo.</language>
		<language name="Japanese">とりけしますか？\nあいてが　いれば　うけとってください</language>
		<language name="Korean">교환을 취소하겠습니까?\n교환되었으면 받아 주십시오</language>
	</row>
	<row id="WonderTrade_Text_Completed" index="30">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Trade completed! Your Pokémon\nis in your party or PC.</language>
		<language name="French">Echange terminé! Votre Pokémon est\ndans l’équipe ou le PC.</language>
		<language name="German">Tausch beendet! Dein Pokémon ist im\nTeam oder PC.</language>
		<language name="Italian">Scambio completato! È nella squadra\no nel PC.</language>
		<language name="Spanish">¡Intercambio hecho! Está en tu\nequipo o el PC.</language>
		<language name="Japanese">こうかん　かんりょう！\nてもちか　ボックスに　います</language>
		<language name="Korean">교환 완료!\n지닌 포켓몬이나 박스에 있습니다</language>
	</row>
	<row id="WonderTrade_Text_Received" index="31">
		<attribute name="window_context_name">used</attribute>
		<language name="English">You received</language>
		<language name="French">Vous avez reçu</language>
		<language name="German">Du hast erhalten:</language>
		<language name="Italian">Hai ricevuto</language>
		<language name="Spanish">Has recibido</language>
		<language name="Japanese">うけとった　ポケモン</language>
		<language name="Korean">받은 포켓몬</language>
	</row>
	<row id="WonderTrade_Text_OriginalTrainer" index="32">
		<attribute name="window_context_name">used</attribute>
		<language name="English">From</language>
		<language name="French">DO</language>
		<language name="German">OT</language>
		<language name="Italian">AO</language>
		<language name="Spanish">EO</language>
		<language name="Japanese">おや</language>
		<language name="Korean">어버이</language>
	</row>
	<row id="WonderTrade_Text_Returned" index="33">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Offer cancelled. Your Pokémon\nis back in your party or PC.</language>
		<language name="French">Offre annulée. Votre Pokémon est\nrevenu.</language>
		<language name="German">Angebot zurückgezogen. Dein Pokémon\nist zurück.</language>
		<language name="Italian">Offerta annullata. Il Pokémon è\ntornato.</language>
		<language name="Spanish">Oferta cancelada. Tu Pokémon ha\nvuelto.</language>
		<language name="Japanese">とりけしました\nポケモンは　もどりました</language>
		<language name="Korean">취소했습니다\n포켓몬이 돌아왔습니다</language>
	</row>
	<row id="WonderTrade_Text_Rejected" index="34">
		<attribute name="window_context_name">used</attribute>
		<language name="English">The server rejected the offer.\nYour Pokémon has been restored.</language>
		<language name="French">Offre refusée par le serveur. Votre\nPokémon est revenu.</language>
		<language name="German">Vom Server abgelehnt. Dein Pokémon\nist zurück.</language>
		<language name="Italian">Offerta rifiutata. Il Pokémon è\ntornato.</language>
		<language name="Spanish">Oferta rechazada. Tu Pokémon ha\nvuelto.</language>
		<language name="Japanese">サーバーが　ことわりました\nポケモンは　もどりました</language>
		<language name="Korean">서버가 거부했습니다\n포켓몬이 돌아왔습니다</language>
	</row>
	<row id="WonderTrade_Text_Superseded" index="35">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Another copy of this save traded\nfirst. Your Pokémon is restored.</language>
		<language name="French">Une copie de la sauvegarde a échangé\navant. Pokémon rendu.</language>
		<language name="German">Eine Spielstand-Kopie war schneller.\nPokémon zurück.</language>
		<language name="Italian">Una copia del salvataggio ha\nscambiato prima. Pokémon reso.</language>
		<language name="Spanish">Otra copia de la partida fue antes.\nPokémon devuelto.</language>
		<language name="Japanese">べつの　コピーが　さきに　こうかん\nポケモンは　もどりました</language>
		<language name="Korean">다른 사본이 먼저 교환했습니다\n포켓몬이 돌아왔습니다</language>
	</row>
	<row id="WonderTrade_Text_Waiting" index="36">
		<attribute name="window_context_name">used</attribute>
		<language name="English">No partner yet. Your Pokémon is\nstill waiting. Check again later.</language>
		<language name="French">Pas encore de partenaire. Revenez\nplus tard.</language>
		<language name="German">Noch kein Tauschpartner. Schau\nspäter wieder vorbei.</language>
		<language name="Italian">Nessun partner per ora. Riprova più\ntardi.</language>
		<language name="Spanish">Aún no hay compañero. Vuelve más\ntarde.</language>
		<language name="Japanese">まだ　あいてが　いません\nあとで　また　みてください</language>
		<language name="Korean">아직 상대가 없습니다\n나중에 다시 확인해 주십시오</language>
	</row>
	<row id="WonderTrade_Text_NoRoom" index="37">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Your result is still pending. Make\nroom in your party or PC first.</language>
		<language name="French">Résultat en attente. Libérez de la\nplace, puis récupérez-le.</language>
		<language name="German">Ergebnis offen. Schaffe Platz und hol\nes dann ab.</language>
		<language name="Italian">Risultato in attesa. Fai spazio e poi\nritiralo.</language>
		<language name="Spanish">Resultado pendiente. Haz sitio y\nluego recógelo.</language>
		<language name="Japanese">けっかは　あずかっています\nあけてから　うけとってください</language>
		<language name="Korean">결과를 맡고 있습니다\n자리를 비운 뒤 받아 주십시오</language>
	</row>
	<row id="WonderTrade_Text_KeepPlaying" index="38">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Wonder Trade needs more play.\nKeep playing, then try again.</language>
		<language name="French">Jouez encore un peu, puis\nréessayez.</language>
		<language name="German">Spiel noch etwas weiter und versuche\nes erneut.</language>
		<language name="Italian">Gioca ancora un po’ e poi riprova.</language>
		<language name="Spanish">Juega un poco más y vuelve a\nintentarlo.</language>
		<language name="Japanese">もうすこし　あそんでから\nもういちど　ためしてください</language>
		<language name="Korean">조금 더 플레이한 뒤\n다시 시도해 주십시오</language>
	</row>
	<row id="WonderTrade_Text_ConfirmAction" index="39">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Confirm</language>
		<language name="French">Confirmer</language>
		<language name="German">Bestätigen</language>
		<language name="Italian">Conferma</language>
		<language name="Spanish">Confirmar</language>
		<language name="Japanese">けってい</language>
		<language name="Korean">결정</language>
	</row>
	<row id="WonderTrade_Text_RecoveryAction" index="40">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Connect and retry</language>
		<language name="French">Reconnecter</language>
		<language name="German">Neu verbinden</language>
		<language name="Italian">Riconnetti</language>
		<language name="Spanish">Reconectar</language>
		<language name="Japanese">せつぞくして　もういちど</language>
		<language name="Korean">다시 접속</language>
	</row>
	<row id="WonderTrade_Text_CannotHold" index="41">
		<attribute name="window_context_name">used</attribute>
		<language name="English">This game can’t hold the received\nPokémon. It stays on the server.</language>
		<language name="French">Ce jeu ne peut pas recevoir ce\nPokémon. Il reste sur le serveur.</language>
		<language name="German">Hier nicht empfangbar. Es bleibt auf\ndem Server.</language>
		<language name="Italian">Questo gioco non può riceverlo.\nResta sul server.</language>
		<language name="Spanish">Este juego no puede tenerlo. Se\nqueda en el servidor.</language>
		<language name="Japanese">この　ソフトでは　あずかれません\nサーバーに　のこります</language>
		<language name="Korean">이 소프트로는 받을 수 없습니다\n서버에 남습니다</language>
	</row>
	<row id="WonderTrade_Text_Level" index="42">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Lv.</language>
		<language name="French">N.</language>
		<language name="German">Lv.</language>
		<language name="Italian">L.</language>
		<language name="Spanish">Nv.</language>
		<language name="Japanese">Lv.</language>
		<language name="Korean">Lv.</language>
	</row>
	<row id="WonderTrade_Text_SaveFirst" index="43">
		<attribute name="window_context_name">used</attribute>
		<language name="English">Save your adventure before\nusing Wonder Trade.</language>
		<language name="French">Sauvegardez avant d’utiliser\nl’Echange Miracle.</language>
		<language name="German">Speichere, bevor du den\nWundertausch nutzt.</language>
		<language name="Italian">Salva prima di usare lo Scambio\nProdigioso.</language>
		<language name="Spanish">Guarda antes de usar el Intercambio\nProdigioso.</language>
		<language name="Japanese">つかう　まえに\nレポートを　かいてください</language>
		<language name="Korean">쓰기 전에\n리포트를 작성해 주십시오</language>
	</row>
</body>
