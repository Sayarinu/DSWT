		<language name="German">Nochmal</language>
		<language name="Italian">Riprova</language>
		<language name="Spanish">Reintentar</language>
		<language name="Japanese">もういちど</language>
		<language name="Korean">다시 시도</language>
	</row>
	<row id="WonderTrade_Text_Back" index="5">
