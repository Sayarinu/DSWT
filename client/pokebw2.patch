+# DSWT Wonder Trade: the Mbed TLS source tree, the connection header and CodeWarrior's MSL C headers, from
+# --wonder-trade-tls, --wonder-trade-profile and --wonder-trade-msl. The shared core (src/wonder_trade/), the
+# Black 2/White 2 adapter (src/wonder_trade/bw2/) and Mbed TLS link at the end of ARM9 main
+# (src/wonder_trade/bw2/link.py), which moves every overlay and the arena after them.
+WONDER_TRADE = None
+# Enroll's game variant code of each version: family 5 (Black 2/White 2) << 24, the game version (Black 2 23, White 2
+# 22) << 16, the language (English 2) << 8 and the revision
+WT_VARIANTS = {"b2_us": 0x05170200, "w2_us": 0x05160200}
+WT_TLS_SRC_DIRS = ["library", "tf-psa-crypto/core", "tf-psa-crypto/extras", "tf-psa-crypto/platform",
+                   "tf-psa-crypto/utilities", "tf-psa-crypto/drivers/builtin/src"]
+WT_TLS_INCLUDE_DIRS = ["include", "library", "tf-psa-crypto/include", "tf-psa-crypto/core", "tf-psa-crypto/dispatch",
+                       "tf-psa-crypto/extras", "tf-psa-crypto/platform", "tf-psa-crypto/utilities",
+                       "tf-psa-crypto/drivers/builtin/include", "tf-psa-crypto/drivers/builtin/src",
+                       "tf-psa-crypto/drivers/p256-m", "tf-psa-crypto/drivers/pqcp/include",
+                       "tf-psa-crypto/drivers/everest/include"]
+
+
+def add_wonder_trade(n: Writer, build_dir: Path, version: str) -> list[str]:
+    """Compiles Wonder Trade and Mbed TLS; returns the objects and the archive to link."""
+    tls_dir = Path(WONDER_TRADE[0])
+    include = build_dir / "wt" / "include"
+    include.mkdir(parents=True, exist_ok=True)
+    shutil.copyfile(WONDER_TRADE[1], include / "wonder_trade_config.h")
+    msl = Path(WONDER_TRADE[2]) / "MSL_C"
+    flags = " ".join([*CC_FLAGS, f"-ir {msl / 'MSL_Common/Include'}", f"-ir {msl / 'MSL_ARM/Include'}",
+                      *(f"-i {d}" for d in INCLUDE_DIRS),
+                      f"-i {include}", *(f"-i {tls_dir / d}" for d in WT_TLS_INCLUDE_DIRS),
+                      "'-DMBEDTLS_CONFIG_FILE=\"wonder_trade/tls_config.h\"'",
+                      "'-DTF_PSA_CRYPTO_CONFIG_FILE=\"wonder_trade/crypto_config.h\"'"])
+    # The core and the adapter see the SDK through include/wonder_trade/bw2/sdk, after the prefix header
+    wt_flags = " ".join([flags, "-i include/wonder_trade/bw2/sdk", "-prefix wonder_trade/bw2/sdk_prefix.h",
+                         f"-DWT_GAME_VARIANT={WT_VARIANTS[version]:#010x}u",
+                         *(f"-d {define}" for define in VERSIONS[version]["defines"])])
+    objects = []
+    for source in sorted([*Path("src/wonder_trade").glob("*.c"), *Path("src/wonder_trade/bw2").glob("*.c")]):
+        prefix = "wt_bw2_" if source.parent.name == "bw2" else "wt_"
+        obj = build_dir / "wt" / f"{prefix}{source.stem}.o"
+        # The rule has no dependency file: a new connection profile rebuilds every Wonder Trade object
+        n.build([obj], "wt_cc", [str(source)], variables={"flags": wt_flags}, order_only=["constants_headers"],
+                implicit=[str(include / "wonder_trade_config.h")])
+        objects.append(str(obj))
+    tls_objects = []
+    for directory in WT_TLS_SRC_DIRS:
+        for source in sorted((tls_dir / directory).glob("*.c")):
+            obj = build_dir / "wt" / "tls" / directory / source.with_suffix(".o").name
+            n.build([obj], "wt_cc", [str(source)], variables={"flags": flags})
+            tls_objects.append(obj)
+    archive = build_dir / "wt" / "libwt_tls.a"
+    n.build([archive], "wt_ar", tls_objects)
+    return [*objects, str(archive)]
+
