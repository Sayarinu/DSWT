diff --git a/tools/gamelink.py b/tools/gamelink.py
index f9e296f22d..e6f568d589 100644
--- a/tools/gamelink.py
+++ b/tools/gamelink.py
@@ -1563,6 +1563,10 @@ def _link_overlay(ovid, interworking=True, absolute_only=False, verbose=True, sk
               ["-nostdlib", "-nodefaults", "-nodeadstrip", "-main", "", "-application", "-map",
                "-o", "ov.elf", "ov.lcf"] + names
         env = dict(os.environ)
+        # mwldarm.exe is a Windows program: run it through wine off Windows, as the compiler is
+        import env as toolenv  # noqa: E402
+        cmd = toolenv.windows_cmd(cmd)
+        toolenv.wine_env(env)
         p = subprocess.run(cmd, cwd=work, capture_output=True, text=True, env=env)
         log = p.stdout + p.stderr
         open(os.path.join(work, "link.log"), "w").write(log)
