+/* DSWT: creates the page indicator: the arrows, and a sprite for the page number */
+void FIELD_MENU_WtCreatePageIndicator(FieldMenu *menu)
+{
+    struct ActorInitParam pos;
+    struct BmpOamParam number;
+    u8 i;
+
+    pos.y = FIELD_MENU_WT_PAGE_Y;
+    pos.draw_priority = 0;
+    pos.bg_priority = 0;
+    for (i = 0; i < 2; i++) {
+        pos.x = i == 0 ? FIELD_MENU_WT_LEFT_X : FIELD_MENU_WT_RIGHT_X;
+        pos.anim_seq = FIELD_MENU_WT_ARROW_SEQ + i;
+        menu->wtPageArrows[i] = CLACT_CreateActor(menu->clactUnit, menu->charResB, menu->palResB, menu->cellResB,
+                                                  &pos, 0, menu->heapId);
+        CLACT_SetActorDrawEnable(menu->wtPageArrows[i], 1);
+    }
+    menu->wtPageOam = BMP_OAM_CreateSys(menu->heapId, menu->clactUnit);
+    menu->wtPageBmp = BMP_Create(FIELD_MENU_WT_NUMBER_WIDTH / 8, 2, 0x20, menu->heapId);
+    number.bmp = menu->wtPageBmp;
+    number.x = FIELD_MENU_WT_NUMBER_X;
+    number.y = FIELD_MENU_WT_NUMBER_Y;
+    /* The palette resource, and the palette within it */
+    number.animResId = menu->palResB;
+    number.palette = 1;
+    number.drawPriority = 0;
+    number.bgPriority = 0;
+    number.space = 0;
+    number.engine = 1;
+    menu->wtPageNumber = BMP_OAM_Create(menu->wtPageOam, &number);
+    BMP_OAM_SetEnabled(menu->wtPageNumber, 1);
+}
