+}
+
+/* DSWT: turns the page without a frame that mixes two: hides the page's names, icons, number and cursor in one VBlank,
+ * loads the other page once they are hidden, and shows it whole once its names have printed (FIELD_MENU_STATE_WT_PAGE) */
+void FIELD_MENU_WtTurnPage(FieldMenu *menu)
+{
+    u8 i;
+
+    GFL_USE_PlaySeDefaultVolume(SE_FIELD_MENU_MOVE);
+    if (menu->selectedItem != 0 && menu->selectedItem->actor != 0) {
+        CLACT_SetActorAnimSeq(menu->selectedItem->actor, 0);
+    }
+    menu->selectedItem = 0;
+    for (i = 0; i < FIELD_MENU_ITEM_BACK; i++) {
+        if (menu->items[i].inUse == 1) {
+            BMP_WIN_ClearScreen(menu->items[i].bmpWin);
+            if (menu->items[i].actor != 0) {
+                CLACT_SetActorDrawEnable(menu->items[i].actor, 0);
+            }
+        }
+    }
+    BG_SYS_MarkTileDirty(6);
+    BMP_OAM_SetEnabled(menu->wtPageNumber, 0);
+    CLACT_SetActorDrawEnable(menu->cursorActor, 0);
+    menu->state = FIELD_MENU_STATE_WT_LOAD;
+}
+
