+    struct GfFont *font = (struct GfFont *)FIELD_MSGBG_GetFont(FIELDMAP_GetMsgBg(menu->fieldMap));
+    void *label = STRBUF_Create(0x10, menu->subHeapId);
+    u32 width = PRINTSYS_MeasureTextWidth((u16 *)gWtFieldMenuPage[menu->wtPage], font, 0, 0);
+
+    STRBUF_SetString(label, gWtFieldMenuPage[menu->wtPage]);
+    BMP_Clear(menu->wtPageBmp, 0);
+    PRINTSYS_PrintColor(menu->wtPageBmp, (FIELD_MENU_WT_NUMBER_WIDTH - width) / 2, 0, label, font,
+                        FIELD_MENU_WT_PAGE_COLOR);
