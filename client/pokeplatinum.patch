+static BOOL StartMenu_SelectWonderTrade(FieldTask *fieldTask)
+{
+    StartMenu *menu = FieldTask_GetEnv(fieldTask);
+    FieldMap_FadeScreen(FADE_TYPE_BRIGHTNESS_OUT);
+    menu->callback = StartMenu_OpenWonderTrade;
+    menu->state = START_MENU_STATE_APP_START;
+    return TRUE;
+}
+
+static BOOL StartMenu_OpenWonderTrade(FieldTask *fieldTask)
+{
+    FieldSystem *fieldSystem = FieldTask_GetFieldSystem(fieldTask);
+    StartMenu *menu = FieldTask_GetEnv(fieldTask);
+    FieldSystem_StartChildProcess(fieldSystem, &gWonderTradeAppTemplate, fieldSystem);
+    menu->callback = StartMenu_ExitWonderTrade;
+    return FALSE;
+}
+
+static BOOL StartMenu_ExitWonderTrade(FieldTask *fieldTask)
+{
+    StartMenu *menu = FieldTask_GetEnv(fieldTask);
+    FieldSystem_StartFieldMap(FieldTask_GetFieldSystem(fieldTask));
+    menu->state = START_MENU_STATE_REINIT;
+    return FALSE;
+}
