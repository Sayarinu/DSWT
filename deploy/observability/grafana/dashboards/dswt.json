        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dswt_oldest_queue_age_seconds",
          "legendFormat": "waiting for a partner"
        },
        {
          "refId": "B",
          "expr": "dswt_oldest_delivery_age_seconds",
          "legendFormat": "waiting to be collected"
        }
      ]
    },
    {
