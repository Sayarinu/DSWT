    {
      "id": 21,
      "type": "timeseries",
      "title": "Replays, refused requests and dropped logs",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
